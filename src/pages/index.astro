    <script is:inline>
        const initFacebookFeedCheck = async () => {
            const liveWrapper = document.getElementById('fb-live-frame');
            const fallbackCard = document.getElementById('fb-fallback-card');
            const iframe = document.getElementById('fb-live-iframe');
            
            const showFallback = () => {
                if (liveWrapper && fallbackCard) {
                    liveWrapper.classList.add('hidden');
                    fallbackCard.classList.remove('hidden');
                }
            };

            const showLiveIframe = () => {
                if (liveWrapper && fallbackCard && iframe) {
                    liveWrapper.innerHTML = '';
                    if (iframe.dataset.src) iframe.src = iframe.dataset.src;
                    iframe.style.height = '500px';
                    iframe.style.opacity = '1';
                    iframe.style.position = 'relative';
                    iframe.style.display = 'block';
                    liveWrapper.appendChild(iframe);
                }
            };

            // Only set iframe.src if live feed actually has posts (preserves 100% cookie-free status)

            // Fallback timeout in case connection fails or is blocked by privacy tools
            const timeout = setTimeout(() => {
                showFallback();
            }, 2500);

            try {
                // Check if Facebook timeline actually returns posts or is empty
                const res = await fetch('/api/check-fb.json');
                const data = await res.json();
                clearTimeout(timeout);
                
                if (data && data.hasPosts === true) {
                    showLiveIframe();
                } else {
                    showFallback();
                }
            } catch (e) {
                clearTimeout(timeout);
                showFallback();
            }
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initFacebookFeedCheck);
        } else {
            initFacebookFeedCheck();
        }
    </script>
