---
// Preloader component for Animal Hope Varna
import fs from 'node:fs';
import path from 'node:path';

const svgPath = path.resolve('./public/logo_AHV.svg');
let logoSvg = '';
try {
  logoSvg = fs.readFileSync(svgPath, 'utf-8');
  logoSvg = logoSvg
    .replace(/<\?xml.*?\?>/g, '')
    .replace(/<sodipodi:namedview[\s\S]*?<\/sodipodi:namedview>/g, '')
    .replace(/<defs[\s\S]*?<\/defs>/g, '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/width="[^"]*"/, 'width="100%"')
    .replace(/height="[^"]*"/, 'height="100%"')
    .trim();
} catch (e) {
  logoSvg = '';
}
---

<!-- Critical inline styles so the preloader renders on frame 0 before external CSS is downloaded -->
<style is:inline>
  /* Prevent any underlying page content from bleeding through Safari's translucent chrome during load */
  html.is-loading,
  html.is-loading body {
    overflow: hidden !important;
    height: 100% !important;
    background-color: #f8fafc !important;
    touch-action: none;
  }

  /* While loading, hide everything under the preloader so nothing peeks through Safari's bottom bar */
  html.is-loading body > :not(#site-preloader) {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  #site-preloader {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: -150px;
    width: 100%;
    width: 100vw;
    min-height: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    min-height: -webkit-fill-available;
    z-index: 999999;
    background-color: #f8fafc;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
    touch-action: none;
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
  }

  #site-preloader.preloader-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .preloader-content {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
    box-sizing: border-box;
  }

  .preloader-logo-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .preloader-glow {
    position: absolute;
    width: clamp(260px, 35vw, 380px);
    height: 70px;
    background: radial-gradient(ellipse at center, rgba(246, 138, 31, 0.22) 0%, rgba(248, 250, 252, 0) 70%);
    border-radius: 9999px;
    pointer-events: none;
    z-index: 0;
    animation: ahv-glow-pulse 2.2s ease-in-out infinite;
  }

  .preloader-logo-pulse {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    animation: ahv-pulse 2.2s ease-in-out infinite;
  }

  .preloader-logo-pulse svg {
    width: clamp(240px, 32vw, 360px);
    max-width: 90vw;
    height: auto;
    aspect-ratio: 425.1969 / 35.732;
    display: block;
  }

  @keyframes ahv-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.94;
    }
    50% {
      transform: scale(1.035);
      opacity: 1;
    }
  }

  @keyframes ahv-glow-pulse {
    0%, 100% {
      transform: scale(0.96);
      opacity: 0.65;
    }
    50% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  @keyframes ahv-progress {
    0% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(35%);
    }
    100% {
      transform: translateX(160%);
    }
  }

  /* Loading bar: hidden on mobile-sized screens (<640px) */
  .preloader-bar-bg {
    display: none;
    width: 150px;
    height: 3px;
    background-color: #e2e8f0;
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
    margin-top: 20px;
    z-index: 1;
  }

  @media (min-width: 640px) {
    .preloader-bar-bg {
      display: block;
    }
  }

  .preloader-bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 55%;
    background: linear-gradient(90deg, #f68a1f, #bd5b00);
    border-radius: 9999px;
    animation: ahv-progress 1.4s ease-in-out infinite;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader-logo-pulse,
    .preloader-bar-fill {
      animation: none !important;
    }
    #site-preloader {
      transition: opacity 0.15s ease !important;
    }
  }
</style>

<div id="site-preloader" aria-hidden="true">
  <div class="preloader-content">
    <!-- Centered Logo with smooth GPU-accelerated pulse and inline SVG -->
    <div class="preloader-logo-container">
      <div class="preloader-glow" aria-hidden="true"></div>
      <div class="preloader-logo-pulse" set:html={logoSvg}></div>
    </div>

    <!-- Elegant subtle indeterminate loading line (hidden on mobile-sized screens) -->
    <div class="preloader-bar-bg hidden sm:block" role="progressbar" aria-label="Зареждане">
      <div class="preloader-bar-fill"></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const preloader = document.getElementById('site-preloader');
    if (!preloader) return;

    // Minimum display time (ms) to avoid jarring flicker on instant cached loads
    const minDisplayTime = 380;
    const startTime = performance.now();
    let isHidden = false;

    // Check for demo/test mode in query params (?loader-test or ?loader-demo)
    const isTestMode = window.location.search.includes('loader-test') || window.location.search.includes('loader-demo');

    function hidePreloader(instant = false) {
      if (isHidden) return;
      isHidden = true;

      if (instant) {
        document.documentElement.classList.remove('is-loading');
        preloader.classList.add('preloader-hidden');
        setTimeout(() => { preloader.style.display = 'none'; }, 50);
        return;
      }

      const elapsed = performance.now() - startTime;
      const targetDelay = isTestMode ? 3000 : Math.max(0, minDisplayTime - elapsed);

      setTimeout(() => {
        // Restore document content visibility right as the preloader begins its fade out
        document.documentElement.classList.remove('is-loading');
        preloader.classList.add('preloader-hidden');
        setTimeout(() => {
          preloader.style.display = 'none';
        }, 450);
      }, targetDelay);
    }

    // Dismiss when entire page (DOM, styles, fonts, images) has loaded
    if (document.readyState === 'complete') {
      hidePreloader();
    } else {
      window.addEventListener('load', () => hidePreloader(), { once: true });
    }

    // Maximum safety fallback (e.g. stalled external font or unpkg script)
    setTimeout(() => {
      hidePreloader();
    }, isTestMode ? 5000 : 4000);

    // Support browser Back/Forward Cache (bfcache)
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        hidePreloader(true);
      }
    });

    // Optional: Smoothly show loader on internal page navigation clicks
    let navTimeout;
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (!link) return;
      const href = link.getAttribute('href');
      if (!href) return;

      // Ignore external links, new tabs, anchor jumps, tel/mailto
      if (
        link.target === '_blank' ||
        e.ctrlKey || e.metaKey || e.shiftKey || e.altKey ||
        href.startsWith('#') ||
        href.startsWith('mailto:') ||
        href.startsWith('tel:') ||
        href.startsWith('javascript:')
      ) {
        return;
      }

      // Check if internal navigation
      try {
        const targetUrl = new URL(link.href, window.location.origin);
        if (targetUrl.origin === window.location.origin) {
          // If navigating to a different page/path
          if (targetUrl.pathname !== window.location.pathname || targetUrl.search !== window.location.search) {
            document.documentElement.classList.add('is-loading');
            preloader.style.display = 'flex';
            void preloader.offsetHeight;
            preloader.classList.remove('preloader-hidden');
            
            // Safety timeout in case navigation is aborted
            clearTimeout(navTimeout);
            navTimeout = setTimeout(() => {
              hidePreloader();
            }, 3500);
          }
        }
      } catch (_) {}
    });
  })();
</script>
